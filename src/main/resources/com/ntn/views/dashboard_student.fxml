<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.ntn.quanlykhoahoc.controllers.DashboardStudentController">

    <!-- Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15px;">
            <Label text="Welcome, Student" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Dashboard" fx:id="dashboardBtn"/>
            <Button text="My Courses" fx:id="coursesBtn"/>
            <Button text="Profile" fx:id="profileBtn"/>
            <Button text="Logout" fx:id="logoutBtn"/>
        </VBox>
    </left>

    <!-- Course List -->
    <center>
        <ScrollPane fitToWidth="true">
            <GridPane fx:id="coursesGrid" hgap="15" vgap="15" style="-fx-padding: 15px;">
                <!-- Các khóa học sẽ được thêm vào bằng code -->
            </GridPane>
        </ScrollPane>
    </center>

    <!-- Cart Section -->
    <right>
        <VBox spacing="10" style="-fx-background-color: #bdc3c7; -fx-padding: 15px;">
            <Label text="Selected Courses"/>
            
            <TableView fx:id="cartTable">
                <columns>
                    <TableColumn text="Course" fx:id="courseColumn"/>
                    <TableColumn text="Price" fx:id="priceColumn"/>
                </columns>
                <placeholder>
                    <Label text="No courses selected"/>
                </placeholder>
            </TableView>

            <Button text="Pay" fx:id="payButton"/>
            <Button text="Remove" fx:id="removeButton"/>
        </VBox>
    </right>

</BorderPane>
