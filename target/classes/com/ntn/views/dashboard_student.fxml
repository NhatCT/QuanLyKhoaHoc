<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.ntn.quanlykhoahoc.controllers.DashboardStudentController">

    <!-- Sidebar (Thanh menu trái) -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" spacing="12"
              style="-fx-padding: 15px; -fx-background-color: #f4f4f4;">
            <Label fx:id="welcomeLabel" text="Welcome, Student" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Button fx:id="dashboardBtn" text="Dashboard" />
            <Button fx:id="coursesBtn" text="My Courses" />
            <Button fx:id="profileBtn" text="Profile" />
            <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- Phần hiển thị danh sách khóa học -->
    <center>
        <VBox spacing="12" style="-fx-padding: 20px;">
            <ScrollPane fx:id="coursesScrollPane" fitToHeight="true" fitToWidth="true"
                        prefHeight="750.0" prefWidth="1000">
                <GridPane fx:id="coursesGrid" prefHeight="750.0" prefWidth="1100"
                          hgap="30" vgap="30">
                </GridPane>
            </ScrollPane>

            <!-- Thanh phân trang -->
            <HBox fx:id="paginationContainer" alignment="CENTER" spacing="12">
                <Button fx:id="prevPageBtn" text="Previous" />
                <Label fx:id="pageLabel" text="Page 1" />
                <Button fx:id="nextPageBtn" text="Next" />
            </HBox>
        </VBox>
    </center>

    <!-- Giỏ hàng (Selected Courses) -->
    <right>
        <VBox fx:id="cartSection" prefWidth="270" spacing="12"
              style="-fx-padding: 15px; -fx-background-color: #f4f4f4;">
            <Label text="Selected Courses" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TableView fx:id="cartTable">
                <columns>
                    <TableColumn fx:id="courseColumn" text="Khóa học" />
                </columns>
            </TableView>
            <Button fx:id="payButton" text="Pay" />
            <Button fx:id="removeButton" text="Remove" />
        </VBox>
    </right>

</BorderPane>
